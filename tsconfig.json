{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "library/*": ["./library/src/*"]   // This is important
    }
  },
  "include": ["src/**/*", "library/**/*"],
  "exclude": ["node_modules", "dist"]
}

